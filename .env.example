# SmartSchool AI — environment variables (copy to .env.local)
#
# Everything prefixed VITE_ is compiled into the public JavaScript bundle.
# Only put PUBLIC values here. Secrets (Gemini key, JWT private key, Firebase
# service account) belong on the server — see server-examples/vercel.

# ---- AI ---------------------------------------------------------------------
# URL of the Gemini proxy. Use /api/ai when the server runs on the same site.
# Leave empty to use the sample generator (no AI). Can also be set in Settings.
VITE_AI_PROXY_URL=

# Gemini model name used by the proxy / dev mode (free-tier friendly default).
VITE_GEMINI_MODEL=gemini-2.5-flash

# ---- Sign-in (identity provider) ----------------------------------------------
# "demo" (default) keeps the no-password account picker. "firebase" enables
# Google Workspace SSO + email/password with TOTP MFA, backed by the auth server.
VITE_AUTH_PROVIDER=demo

# Firebase web app config (public identifiers, not secrets).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional: preselect your Google Workspace domain on the Google sign-in screen.
VITE_GOOGLE_WORKSPACE_DOMAIN=

# Base URL of the auth server. Empty = same origin (/api/auth/...). It must be on
# the same site as the app or the SameSite=Strict refresh cookie is not sent.
VITE_API_BASE_URL=

# Local dev only: proxy /api to the auth server, e.g. http://localhost:3000 (vercel dev).
DEV_API_TARGET=

# ---- Google Drive import -------------------------------------------------------
# OAuth web client ID (authorised JavaScript origin = this app's URL).
VITE_GOOGLE_CLIENT_ID=
# Browser API key restricted to the Google Picker API and this app's HTTP referrer.
VITE_GOOGLE_API_KEY=
# Google Cloud project number (lets Drive grant the app access to picked files).
VITE_GOOGLE_APP_ID=
